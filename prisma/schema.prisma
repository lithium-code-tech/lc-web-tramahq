generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  scripts   Script[]
  createdAt DateTime @default(now())
}

enum ProjectType {
  GRAPHIC_NOVEL
  SERIES
}

model Script {
  id          String      @id @default(cuid())
  title       String
  projectType ProjectType @default(SERIES)
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id])
  pages       Page[]
  characters  Character[]
  pitchDraft  String      @default("") @db.Text
  pitches     Pitch[]
  editions    Edition[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Edition {
  id       String @id @default(cuid())
  scriptId String
  script   Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  number   Int
  text     String @db.Text

  @@unique([scriptId, number])
}

model Pitch {
  id        String   @id @default(cuid())
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  version   Int
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@unique([scriptId, version])
}

model Page {
  id       String  @id @default(cuid())
  scriptId String
  script   Script  @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  number   Int
  plotText String? @db.Text
  blocks   Block[]

  @@unique([scriptId, number])
}

enum BlockType {
  QUADRO
  DIALOGO
  ONOMATOPEIA
}

model Block {
  id        String    @id @default(cuid())
  pageId    String
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  order     Int
  type      BlockType
  number    Int?
  character String?
  text      String    @db.Text
}

model Character {
  id          String  @id @default(cuid())
  scriptId    String
  script      Script  @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  name        String
  description String? @db.Text
}
